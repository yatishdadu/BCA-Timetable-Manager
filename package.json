{
  "name": "bca-timetable-manager",
  "version": "0.1.6",
  "description": "Professional Windows desktop application for BCA timetable management",
  "main": "dist/main/index.mjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "postinstall": "npx @electron/rebuild -f -v",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron -r ts-node/register src/main/index.ts",
    "build": "npm run build:production && electron-builder --win nsis",
    "test": "jest",
    "build:renderer": "vite build --config vite.production.config.ts",
    "build:desktop": "node scripts/build-electron.cjs",
    "build:production": "npm run build:renderer && npm run build:desktop && node scripts/check-production.cjs",
    "build:unpacked": "npm run build:production && electron-builder --win --dir"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "exceljs": "4.4.0",
    "knex": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.22.0",
    "sqlite3": "^5.1.7",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.5.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^20.14.2",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.23",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.13.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "wait-on": "^9.5.1",
    "electron": "^45.1.0",
    "esbuild": "^0.21.5"
  }
}
